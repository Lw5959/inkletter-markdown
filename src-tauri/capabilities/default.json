{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "本机编辑窗口与文件对话框",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main", "document-*"],
  "permissions": ["core:default", "core:window:allow-destroy", "core:window:allow-start-dragging", "core:window:allow-set-focus", "core:window:allow-set-fullscreen", "core:window:allow-set-theme", "core:webview:allow-set-webview-zoom", "dialog:allow-open", "dialog:allow-save", "dialog:allow-message"]
}
