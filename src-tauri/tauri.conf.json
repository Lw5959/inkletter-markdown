{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yeyu",
  "version": "0.2.23",
  "identifier": "io.yeyu.markdown",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "页屿", "width": 1200, "height": 800, "minWidth": 640, "minHeight": 480, "dragDropEnabled": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRUFERTJDMTA5NTkwODEKUldTQmtKVVFMTjdxRWlxekJSdm9Fd0w0MkNScS82eVlxK1JCRzQ3c1dTSDV1TjBJcGJpNnROVHAK",
      "endpoints": [
        "https://github.com/Lw5959/yeyu/releases/latest/download/latest.json",
        "https://gitee.com/Lw5959/yeyu/raw/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "linux": {
      "deb": { "desktopTemplate": "installer/yeyu.desktop" },
      "rpm": { "desktopTemplate": "installer/yeyu.desktop" }
    },
    "resources": {
      "../examples/plugins/LICENSE": "licenses/yeyu-plugins.txt",
      "../examples/plugins/THIRD-PARTY-NOTICES.txt": "licenses/yeyu-plugin-dependencies.txt",
      "licenses/plugin-runtime.txt": "licenses/plugin-runtime.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{
      "ext": ["md", "markdown"],
      "contentTypes": ["net.daringfireball.markdown"],
      "mimeType": "text/markdown",
      "name": "Markdown",
      "role": "Editor"
    }]
  }
}
